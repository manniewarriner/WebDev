<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OrchDesk</AssemblyName>
    <RootNamespace>OrchDesk.App</RootNamespace>
    <Version>0.3.0</Version>
    <!-- Lets this project compile on Linux/CI for checks; it still only runs on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Single-file publish: WPF's native DLLs must be bundled and self-extracted. Trimming is unsupported for WPF. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <ApplicationIcon Condition="Exists('Assets\orch-app-icon.ico')">Assets\orch-app-icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\orch-app-icon.ico" />
    <Resource Include="Assets\orch-app-icon-512.png" />
    <Resource Include="Assets\Fonts\*.ttf" />
    <Resource Include="Assets\Fonts\*.txt" />
    <Resource Include="Assets\UI-NOTICE.md" />
    <Resource Include="Assets\Icon\*.png" />
    <ProjectReference Include="..\OrchDesk.Core\OrchDesk.Core.csproj" />
  </ItemGroup>

</Project>
