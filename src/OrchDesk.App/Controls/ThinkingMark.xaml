<UserControl x:Class="OrchDesk.App.Controls.ThinkingMark"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="72" Height="28">
    <!-- Placeholder mark until the real logo file is added: a terracotta "O" with a peach orbit dot,
         followed by three dots that ripple while a model is working. -->
    <Canvas>
        <Ellipse Width="22" Height="22" Canvas.Left="2" Canvas.Top="3" StrokeThickness="4" Stroke="{DynamicResource AccentBrush}" />
        <Ellipse x:Name="Orbit" Width="7" Height="7" Canvas.Left="19" Canvas.Top="1" Fill="{DynamicResource PeachBrush}"
                 RenderTransformOrigin="-0.857,1.857">
            <Ellipse.RenderTransform>
                <RotateTransform x:Name="OrbitRotate" Angle="0" />
            </Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse x:Name="Dot1" Width="5" Height="5" Canvas.Left="34" Canvas.Top="17" Fill="{DynamicResource PeachBrush}" Opacity="0" />
        <Ellipse x:Name="Dot2" Width="5" Height="5" Canvas.Left="43" Canvas.Top="17" Fill="{DynamicResource PeachBrush}" Opacity="0" />
        <Ellipse x:Name="Dot3" Width="5" Height="5" Canvas.Left="52" Canvas.Top="17" Fill="{DynamicResource PeachBrush}" Opacity="0" />
    </Canvas>
</UserControl>
