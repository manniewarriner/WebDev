                    <Border Margin="{StaticResource Inset.8_0}" CornerRadius="{StaticResource Radius.Input}"><Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding FullAccess}" Value="True"><Setter Property="Background"><Setter.Value><SolidColorBrush Color="{Binding Color, Source={StaticResource AccentBrush}}" Opacity="0.16"/></Setter.Value></Setter></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE83D;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="{StaticResource Inset.8_0_0_0}" Foreground="{DynamicResource AccentBrush}"/><ComboBox SelectedIndex="{Binding PermissionIndex}" MinWidth="112" ToolTip="Workspace permissions"><ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource PermissionsChip}"><Style.Triggers><DataTrigger Binding="{Binding FullAccess}" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></ComboBox.Style><ComboBoxItem Content="Ask first"/><ComboBoxItem Content="Full access"/></ComboBox></StackPanel></Border>
