                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Check now" Command="{Binding CheckNowCommand}" VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource Heading}" Text="Models &amp; accounts" />
                </DockPanel>
                <TextBlock Style="{StaticResource Muted}" Margin="{StaticResource Inset.0_8_0_16}" LineHeight="{StaticResource Metric.19}"
                           Text="In Auto mode OrchDesk tries these in order. When your PC is off or an account hits its limit, it moves to the next one and comes back later. Change the order in Settings." />

                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:AccountRow}">
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="{StaticResource Inset.0_0_0_1}" Padding="{StaticResource Inset.0_16}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Position}" Width="{StaticResource Metric.34}" FontFamily="{StaticResource DisplayFont}"
                                               FontSize="{StaticResource Metric.18}" Foreground="{DynamicResource PeachBrush}" VerticalAlignment="Top" />
                                    <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" MinWidth="{StaticResource Metric.200}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Ellipse Width="{StaticResource Metric.8}" Height="{StaticResource Metric.8}" Margin="{StaticResource Inset.0_0_8_0}" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource MutedBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Tone}" Value="ok"><Setter Property="Fill" Value="{DynamicResource SuccessBrush}" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding Tone}" Value="warn"><Setter Property="Fill" Value="{DynamicResource WarnBrush}" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding Tone}" Value="bad"><Setter Property="Fill" Value="{DynamicResource DangerBrush}" /></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding HealthText}" Style="{StaticResource Body}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding LimitText}" Style="{StaticResource Muted}" HorizontalAlignment="Right" Margin="{StaticResource Inset.0_0_0_0}"
                                                   Visibility="{Binding HasLimit, Converter={StaticResource BoolVisible}}" />
                                        <Button Content="Clear limit" Command="{Binding ClearLimitCommand}" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                                                Visibility="{Binding HasLimit, Converter={StaticResource BoolVisible}}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" FontWeight="SemiBold" FontSize="{StaticResource Metric.15}" />
                                        <TextBlock Text="{Binding Kind}" Style="{StaticResource Muted}" />
