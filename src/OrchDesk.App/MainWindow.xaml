<Window x:Class="OrchDesk.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:OrchDesk.App.ViewModels"
        xmlns:ctl="clr-namespace:OrchDesk.App.Controls"
        xmlns:core="clr-namespace:OrchDesk.Core.Overnight;assembly=OrchDesk.Core"
        Title="OrchDesk" Width="{StaticResource Metric.1180}" Height="{StaticResource Metric.780}" MinWidth="900" MinHeight="{StaticResource Metric.520}"
        Background="{DynamicResource BaseBrush}" Foreground="{DynamicResource TextBrush}"
        Icon="Assets/orch-app-icon.ico" UseLayoutRounding="True" SnapsToDevicePixels="True" FontFamily="{StaticResource UiFont}" WindowStartupLocation="CenterScreen">

    <Window.Resources><Style x:Key="BentoCard" TargetType="Button">
<Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Height" Value="104"/><Setter Property="Padding" Value="16"/><Setter Property="Margin" Value="0,0,8,8"/>
<Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Card" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource Round.12}" Padding="{TemplateBinding Padding}"><Border.RenderTransform><TranslateTransform/></Border.RenderTransform><ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="RenderTransform"><Setter.Value><TranslateTransform/></Setter.Value></Setter><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <CollectionViewSource x:Key="GroupedModels" Source="{Binding Chat.ProviderOptions}">
            <CollectionViewSource.GroupDescriptions><PropertyGroupDescription PropertyName="ProviderGroup" /></CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </Window.Resources>
    <Grid x:Name="ShellRoot" PreviewMouseDown="DismissModelPicker">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ───────── Left rail ───────── -->
        <Border x:Name="Sidebar" Width="{StaticResource Metric.224}" ClipToBounds="True" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="{StaticResource Inset.0_0_1_0}">
            <DockPanel Margin="{StaticResource Inset.0_16_0_16}">
                <Button DockPanel.Dock="Top" Content="☰" Click="ToggleSidebar" ToolTip="Collapse or expand sidebar" HorizontalAlignment="Left" Margin="{StaticResource Inset.12_0_0_16}" Style="{StaticResource GhostButton}" />
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="{StaticResource Inset.16_0_0_16}"><Image Source="Assets/orch-app-icon-512.png" Width="{StaticResource Metric.32}" Height="{StaticResource Metric.32}" RenderOptions.BitmapScalingMode="HighQuality" Margin="{StaticResource Inset.0_0_10_0}" /><TextBlock x:Name="SidebarTitle" Text="OrchDesk" VerticalAlignment="Center" FontFamily="{StaticResource DisplayFont}" FontSize="{StaticResource Metric.24}" /></StackPanel>

                <Button x:Name="AvatarButton" DockPanel.Dock="Bottom" Click="OpenAccountMenu" HorizontalAlignment="Left" Margin="{StaticResource Inset.12_12_0_0}" Padding="{StaticResource Inset.0}" Background="Transparent" BorderThickness="{StaticResource Inset.0}"><StackPanel Orientation="Horizontal"><Border x:Name="AvatarRing" Width="{StaticResource Metric.40}" Height="{StaticResource Metric.40}" CornerRadius="{StaticResource Round.20}" BorderThickness="{StaticResource Inset.2}" BorderBrush="{DynamicResource MutedBrush}" Padding="{StaticResource Inset.3}"><Grid><Ellipse x:Name="AvatarImage"/><TextBlock x:Name="AvatarInitials" Text="MW" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" /></Grid></Border><StackPanel x:Name="AvatarDetails" VerticalAlignment="Center" Margin="{StaticResource Inset.12_0_0_0}"><TextBlock x:Name="SidebarProfileName" FontWeight="SemiBold" FontSize="{StaticResource Metric.13}"/><TextBlock x:Name="ProfileStatus" Text="{Binding ConnectionStatus}" TextTrimming="CharacterEllipsis" FontSize="{StaticResource Metric.11}" Foreground="{DynamicResource MutedBrush}"/></StackPanel></StackPanel></Button>
                <StackPanel x:Name="RailFooter" DockPanel.Dock="Bottom" Visibility="Collapsed" Margin="{StaticResource Inset.8_0}"><Button Content="◷" ToolTip="Recent chats" Click="ToggleSidebar" Style="{StaticResource GhostButton}"/><Button Content="⚙" ToolTip="Settings" Command="{Binding OpenSettingsCommand}" Style="{StaticResource GhostButton}"/><Button Content="◐" ToolTip="Switch theme" Command="{Binding ToggleThemeCommand}" Style="{StaticResource GhostButton}"/></StackPanel>
                <StackPanel x:Name="SidebarFooter" DockPanel.Dock="Bottom" Margin="{StaticResource Inset.16_0}">
                    <TextBlock x:Name="SidebarStatusText" TextTrimming="CharacterEllipsis" ToolTip="{Binding SidebarStatus}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                <Setter Property="Text" Value="{Binding SidebarStatus}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Chat.IsBusy}" Value="True">
                                        <Setter Property="Text" Value="Answering now" />
                                    </DataTrigger>
                                <DataTrigger Binding="{Binding Chat.IsThinking}" Value="True"><Setter Property="Text" Value="Thinking now" /></DataTrigger></Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <DockPanel Margin="{StaticResource Inset.0_8_0_16}"><ctl:ProviderLogo DockPanel.Dock="Left" Provider="{Binding Accounts.ActiveProvider}" Width="{StaticResource Metric.18}" Height="{StaticResource Metric.18}" Margin="{StaticResource Inset.0_0_8_0}" /><TextBlock Text="{Binding Accounts.ActiveName}" TextWrapping="NoWrap" ToolTip="{Binding Accounts.ActiveName}" TextTrimming="CharacterEllipsis" Style="{StaticResource Body}" /></DockPanel>
                    <StackPanel><Button Content="Settings" Command="{Binding OpenSettingsCommand}" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Padding="{StaticResource Inset.0_8}"/><ctl:SegmentedControl x:Name="ThemeSegment" First="Dark" Second="Light" Margin="{StaticResource Inset.0_8_0_0}"/></StackPanel>
                </StackPanel>

                <StackPanel>
                    <RadioButton ToolTip="Chat" Style="{StaticResource NavButton}" GroupName="nav"
                                 IsChecked="{Binding Page, Converter={StaticResource PageEquals}, ConverterParameter=Chat}">
                        <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8F2;" Margin="{StaticResource Inset.0_0_16_0}" FontSize="{StaticResource Metric.15}" /><TextBlock x:Name="ChatNavLabel" Text="Chat" /></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="nav" ToolTip="Models and accounts"
                                 IsChecked="{Binding Page, Converter={StaticResource PageEquals}, ConverterParameter=Accounts}">
                        <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE713;" Margin="{StaticResource Inset.0_0_16_0}" FontSize="{StaticResource Metric.15}" /><TextBlock x:Name="AccountsNavLabel" Text="Models &amp; accounts" /></StackPanel>
                    </RadioButton>
                    <StackPanel x:Name="HistoryPanel" Margin="{StaticResource Inset.16_16_16_0}"><ctl:TrackingLabel Text="RECENT CHATS" FontSize="{StaticResource Metric.11}" Margin="{StaticResource Inset.0_0_0_12}"/><Grid Margin="{StaticResource Inset.0_0_0_8}"><TextBox x:Name="HistorySearch" TextChanged="HistorySearchChanged" ToolTip="Search chat titles" Height="{StaticResource Metric.32}" Padding="{StaticResource Inset.28_4_8_4}" Margin="{StaticResource Inset.0}"/><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE721;" Margin="{StaticResource Inset.8_0_0_0}" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False"/><TextBlock  Text="Search chats" IsHitTestVisible="False" Margin="{StaticResource Inset.28_0_4_0}" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=HistorySearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><ctl:FilterBar x:Name="HistoryFilters" Margin="{StaticResource Inset.0_0_0_8}"/><ctl:SkeletonRows x:Name="HistorySkeleton" Visibility="Collapsed"/><TextBlock Text="No chats yet" Foreground="{DynamicResource MutedBrush}" Margin="{StaticResource Inset.0_8_0_0}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Items.Count, ElementName=HistoryList}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><ItemsControl x:Name="HistoryList"><ItemsControl.ItemTemplate><DataTemplate><Grid Height="{StaticResource Metric.32}"><Grid.ContextMenu><ContextMenu><MenuItem Header="Delete chat" Click="DeleteHistoryMenu"/></ContextMenu></Grid.ContextMenu><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions><Button Tag="{Binding}" Click="RestoreChat" HorizontalContentAlignment="Left" Style="{StaticResource GhostButton}" ToolTip="{Binding Title}"><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/></Button><Button Grid.Column="1" Click="DeleteHistoryClick" ToolTip="Delete chat" Content="&#xE74D;" FontFamily="Segoe Fluent Icons"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource GhostButton}"><Setter Property="Opacity" Value="0"/><Style.Triggers><DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True"><Setter Property="Opacity" Value="1"/></DataTrigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="Opacity" Value="1"/></Trigger></Style.Triggers></Style></Button.Style></Button></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ───────── Chat page ───────── -->
        <Grid Grid.Column="1" DataContext="{Binding Chat}"
              Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageVisible}, ConverterParameter=Chat}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: folder, mode, model -->
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="{StaticResource Inset.0_0_0_1}" Padding="{StaticResource Inset.24_10}">
                <StackPanel>
                    <Button Command="{Binding PickFolderCommand}" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" HorizontalContentAlignment="Left" ToolTip="Change project folder" Margin="{StaticResource Inset.0_0_0_4}">
                        <TextBlock Text="{Binding WorkspaceLabel}" FontFamily="{StaticResource CodeFont}" FontSize="{StaticResource Metric.13}" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="{StaticResource Metric.720}" />
                    </Button>
                    <StackPanel Orientation="Vertical">
                        <!-- Row 1: Provider, Modes, Open file, New chat -->
                        <DockPanel LastChildFill="True">
                            <ctl:SegmentedControl x:Name="WorkModeSegment" Height="36" DockPanel.Dock="Right" VerticalAlignment="Top" Margin="{StaticResource Inset.8_0_0_8}"/>
                            <StackPanel Orientation="Horizontal">
                            <ComboBox Height="32" MinHeight="32" Width="{StaticResource Metric.112}" ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" ToolTip="Chat or cost routing" Margin="{StaticResource Inset.0_0_8_8}" />
                            <Button Height="32" MinHeight="32" Content="Open file" Command="{Binding OpenFileCommand}" Margin="{StaticResource Inset.0_0_8_8}">
                                <Button.Style>
                                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="IsEnabled" Value="True" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Workspace}" Value="{x:Null}">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Border Width="1" Height="24" Background="{DynamicResource BorderBrush}" Margin="{StaticResource Inset.0_4_8_0}"/><Button x:Name="CommandsAction" Style="{StaticResource GhostButton}" Content="Commands" ToolTip="Commands · Ctrl+K" Click="OpenPaletteClick" Margin="{StaticResource Inset.0_0_8_8}"/><Button x:Name="UsageAction" Style="{StaticResource GhostButton}" Content="Usage" Click="OpenUsageClick" Margin="{StaticResource Inset.0_0_8_8}"/><Button x:Name="FilesAction" Style="{StaticResource GhostButton}" Content="Files" Click="OpenFilesClick" Margin="{StaticResource Inset.0_0_8_8}"/><Button Height="32" MinHeight="32" Content="New chat" Command="{Binding NewChatCommand}" Style="{StaticResource GhostButton}" Margin="{StaticResource Inset.0_0_8_8}" />
                        <!-- Overnight actions -->
                            <Border Width="1" Height="24" Background="{DynamicResource BorderBrush}" Margin="{StaticResource Inset.0_4_8_0}"/><Button x:Name="MoreActions" Content="&#x22EF;" ToolTip="Chat actions" Click="OpenMoreActions" Margin="{StaticResource Inset.0_0_8_8}" Visibility="Collapsed"/>
                        </StackPanel></DockPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Expander Grid.Row="1" Header="File editor" VerticalAlignment="Top" Background="{DynamicResource SurfaceBrush}">
                <Expander.Style>
                    <Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding EditorPath}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding EditorPath}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Expander.Style>
                <StackPanel Margin="{StaticResource Inset.16}">
                    <DockPanel><Button DockPanel.Dock="Right" Content="Save" Command="{Binding SaveFileCommand}" /><TextBlock Text="{Binding EditorPath}" TextTrimming="CharacterEllipsis" /></DockPanel>
                    <TextBox Text="{Binding EditorText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True" Height="{StaticResource Metric.260}" VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource CodeFont}" />
                </StackPanel>
            </Expander>
            <ctl:EvervaultBackground x:Name="ChatBackdrop" Visibility="Collapsed" Grid.Row="2" />
            <ctl:FilterBar x:Name="JobFilters" Visibility="Collapsed" Grid.Row="1" HorizontalAlignment="Right" Margin="{StaticResource Inset.16_2}"/>
            <!-- Empty state -->
            <ScrollViewer x:Name="HomeContent" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="{StaticResource Inset.24_24_24_16}">
            <StackPanel HorizontalAlignment="Stretch" MaxWidth="{StaticResource Metric.820}">
                <TextBlock Style="{StaticResource Heading}" Text="Make room for your next idea." TextWrapping="Wrap" Padding="{StaticResource Inset.0_4_0_0}" Margin="{StaticResource Inset.0_0_0_16}" />
                <TextBlock Style="{StaticResource Body}" Foreground="{DynamicResource MutedBrush}" LineHeight="{StaticResource Metric.21}"
                           Text="Choose a project or start a conversation below." />
                <UniformGrid Columns="2" Margin="{StaticResource Inset.0_24_0_0}"><Button Style="{StaticResource BentoCard}" Command="{Binding PickFolderCommand}"><StackPanel><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8B7;" FontSize="{StaticResource Metric.20}" Foreground="{DynamicResource AccentBrush}" Margin="{StaticResource Inset.0_0_0_12}"/><TextBlock Text="Explore a project" FontSize="{StaticResource Metric.15}" FontWeight="SemiBold" Margin="{StaticResource Inset.0_0_0_4}"/><TextBlock Text="Choose a folder and start building." FontSize="{StaticResource Metric.12}" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/></StackPanel></Button><Button Style="{StaticResource BentoCard}" Click="OpenOvernightSetup"><StackPanel><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE708;" FontSize="{StaticResource Metric.20}" Foreground="{DynamicResource AccentBrush}" Margin="{StaticResource Inset.0_0_0_12}"/><TextBlock Text="Plan an overnight run" FontSize="{StaticResource Metric.15}" FontWeight="SemiBold" Margin="{StaticResource Inset.0_0_0_4}"/><TextBlock Text="Set a goal for the hours ahead." FontSize="{StaticResource Metric.12}" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/></StackPanel></Button></UniformGrid><ctl:TrackingLabel Visibility="Collapsed" Text="ACTIVITY" FontSize="{StaticResource Metric.11}" Margin="{StaticResource Inset.0_16_0_0}"/><ctl:ActivityHeatmap x:Name="HomeActivity" Visibility="Collapsed" Width="338" HorizontalAlignment="Left"/>

                <ItemsControl ItemsSource="{Binding RecentFolders}" Margin="{StaticResource Inset.0_12_0_0}"><ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource GhostButton}" Content="{Binding}" Command="{Binding DataContext.OpenRecentFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" HorizontalAlignment="Left"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel>

            </ScrollViewer>

            <!-- Conversation -->
            <ScrollViewer x:Name="ChatScroll" Visibility="Collapsed" ScrollChanged="ThreadScrolled" Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="{StaticResource Inset.0_8}">
                <ScrollViewer.Style><Style TargetType="ScrollViewer"><Style.Triggers><DataTrigger Binding="{Binding Visibility, ElementName=JumpLatest}" Value="Visible"><Setter Property="Margin" Value="{StaticResource Inset.0_0_0_56}"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style>
                <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource QuietScrollBar}" /></ScrollViewer.Resources>
                <ItemsControl ItemsSource="{Binding Items}" MaxWidth="{StaticResource Metric.820}" Margin="{StaticResource Inset.24_16}" Focusable="False">
                    <ItemsControl.Resources>
                        <DataTemplate DataType="{x:Type vm:TeamItem}">
                            <Border Padding="{StaticResource Inset.16}" Margin="{StaticResource Inset.0_0_0_16}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource RaisedBrush}" CornerRadius="{StaticResource Round.8}"><StackPanel>
                                <TextBlock Text="{Binding Header}" FontSize="{StaticResource Metric.14}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding ThoughtSummary}" ToolTip="{Binding UsageTooltip}" FontSize="{StaticResource Metric.13}" Margin="{StaticResource Inset.0_8}"/>
                                <ItemsControl ItemsSource="{Binding Cards}"><ItemsControl.ItemTemplate><DataTemplate>
                                    <Border Padding="{StaticResource Inset.16}" Margin="{StaticResource Inset.0_0_0_8}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource Round.8}"><StackPanel>
                                        <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Status}" FontSize="{StaticResource Metric.11}"/><TextBlock Text="{Binding Title}" FontSize="{StaticResource Metric.14}" TextWrapping="Wrap"/></DockPanel>
                                        <StackPanel Orientation="Horizontal" Margin="{StaticResource Inset.0_4}"><TextBlock Text="{Binding Role}" FontSize="{StaticResource Metric.11}"/><TextBlock Text="{Binding Model}" FontSize="{StaticResource Metric.11}" Margin="{StaticResource Inset.8_0_0_0}"/></StackPanel>
                                        <TextBlock Text="{Binding ThoughtSummary}" ToolTip="{Binding Tooltip}" FontSize="{StaticResource Metric.13}" Foreground="{DynamicResource MutedBrush}"/>
                                        <Expander Header="Output / review" Margin="{StaticResource Inset.0_8_0_0}"><TextBlock Text="{Binding Output}" TextWrapping="Wrap" FontSize="{StaticResource Metric.13}"/></Expander>
                                    </StackPanel></Border>
                                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                <Expander Header="Per-model usage"><TextBlock Text="{Binding ModelUsage}" FontSize="{StaticResource Metric.12}" TextWrapping="Wrap"/></Expander>
                            </StackPanel></Border>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:UserItem}">
                            <Border Background="{DynamicResource UserBubbleBrush}" CornerRadius="{StaticResource Round.16_16_4_16}" Padding="{StaticResource Inset.16}"
                                    HorizontalAlignment="Right" MaxWidth="{StaticResource Metric.600}" Margin="{StaticResource Inset.80_16_0_8}">
                                <TextBox Style="{StaticResource MessageText}" Text="{Binding Text, Mode=OneWay}" />
                            </Border>
                        </DataTemplate>

                        <DataTemplate DataType="{x:Type vm:AssistantItem}">
                            <StackPanel Margin="{StaticResource Inset.0_20_28_16}">
                                <StackPanel Orientation="Horizontal" Margin="{StaticResource Inset.0_0_0_10}"><ctl:ProviderLogo Provider="{Binding Provider}" Width="{StaticResource Metric.16}" Height="{StaticResource Metric.16}" Margin="{StaticResource Inset.0_0_8_0}"/><TextBlock Text="{Binding ModelName}" Style="{StaticResource Muted}" /></StackPanel>
                                <Expander Header="Reasoning" Visibility="{Binding Reasoning, Converter={StaticResource HasValue}}" Margin="{StaticResource Inset.0_0_0_12}"><TextBlock Text="{Binding Reasoning}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="{StaticResource Inset.12}" /></Expander>
                                <TextBlock Text="{Binding ThoughtSummary}" ToolTip="{Binding UsageTooltip}" Style="{StaticResource Muted}" Margin="{StaticResource Inset.0_0_0_8}" Visibility="{Binding ThoughtSummary, Converter={StaticResource HasValue}}"/>
                                <TextBlock TextWrapping="Wrap" FontSize="{StaticResource Metric.14}" LineHeight="{StaticResource Metric.23}" Foreground="{DynamicResource TextBrush}"><Run Text="{Binding Text, Mode=OneWay}"/><InlineUIContainer><ctl:MotionGlyph Text="▍" FontSize="{StaticResource Metric.14}" Foreground="{DynamicResource AccentBrush}" Visibility="{Binding IsStreaming, Converter={StaticResource BoolVisible}}" /></InlineUIContainer></TextBlock>
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:ToolItem}">
                            <Border CornerRadius="{StaticResource Radius.Dialog}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="{StaticResource Inset.1}" Background="{DynamicResource RaisedBrush}" Margin="{StaticResource Inset.0_6_28_8}">
                                <StackPanel>
                                    <Button Command="{Binding ToggleCommand}" HorizontalContentAlignment="Stretch" Padding="{StaticResource Inset.14_10}" Style="{StaticResource GhostButton}" ToolTip="Expand tool arguments and result">
                                        <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Duration}" Foreground="{DynamicResource MutedBrush}" Margin="{StaticResource Inset.12_0}"/><TextBlock DockPanel.Dock="Right" Text="⌄"/><ctl:MotionGlyph DockPanel.Dock="Left" Text="◌" Spin="True" Margin="{StaticResource Inset.0_0_10_0}" Visibility="{Binding IsRunning, Converter={StaticResource BoolVisible}}"/><TextBlock DockPanel.Dock="Left" Text="{Binding StateIcon}" Margin="{StaticResource Inset.0_0_10_0}" Visibility="{Binding IsRunning, Converter={StaticResource BoolVisible}, ConverterParameter=invert}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsError}" Value="True"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" /></DockPanel>
                                    </Button>
                                    <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BoolVisible}}" Margin="{StaticResource Inset.14_0_14_14}">
                                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="{StaticResource Inset.0_1_0_0}" Margin="{StaticResource Inset.n14_0_n14_12}"/>
                                        <ctl:TrackingLabel Text="ARGUMENTS" FontSize="{StaticResource Metric.11}" Foreground="{DynamicResource MutedBrush}" Margin="{StaticResource Inset.0_0_0_8}"/>
                                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="{StaticResource Round.8}" Padding="{StaticResource Inset.10}"><TextBox Style="{StaticResource CodeText}" Text="{Binding Arguments, Mode=OneWay}" /></Border>
                                        <DockPanel Margin="{StaticResource Inset.0_12_0_8}"><Button DockPanel.Dock="Right" Content="Copy result" Click="CopyToolOutput" MinHeight="{StaticResource Metric.24}" Padding="{StaticResource Inset.8_0}" Style="{StaticResource GhostButton}"/><ctl:TrackingLabel Text="RESULT" FontSize="{StaticResource Metric.11}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/></DockPanel>
                                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="{StaticResource Round.8}" Padding="{StaticResource Inset.10}"><ScrollViewer MaxHeight="{StaticResource Metric.200}" VerticalScrollBarVisibility="Auto"><TextBox Style="{StaticResource CodeText}" Text="{Binding Output, Mode=OneWay}" /></ScrollViewer></Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>

                        <DataTemplate DataType="{x:Type vm:PlanItem}">
                            <Border Padding="{StaticResource Inset.16}" Margin="{StaticResource Inset.0_16_28_16}" CornerRadius="{StaticResource Round.10}" Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                                <StackPanel><TextBlock Text="Implementation plan" FontWeight="SemiBold" FontSize="{StaticResource Space.16}" Margin="{StaticResource Inset.0_0_0_12}"/>
                                    <ItemsControl ItemsSource="{Binding Steps}" IsEnabled="{Binding IsPending}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="{StaticResource Inset.0_4}"><TextBlock DockPanel.Dock="Left" Text="{Binding Number}" VerticalAlignment="Center" Margin="{StaticResource Inset.0_0_8_0}"/><Button DockPanel.Dock="Right" Content="Remove" Command="{Binding DataContext.RemoveStepCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/><TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MinWidth="280"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                    <StackPanel Orientation="Horizontal" Margin="{StaticResource Inset.0_12_0_0}" IsEnabled="{Binding IsPending}"><Button Content="Add step" Command="{Binding AddStepCommand}"/><Button Content="Approve &amp; run" Command="{Binding ApproveCommand}" IsEnabled="{Binding CanApprove}" Style="{StaticResource AccentButton}" Margin="{StaticResource Inset.8_0}"/><Button Content="Cancel" Command="{Binding CancelCommand}"/></StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:StatusItem}">
                            <TextBlock Text="{Binding Text}" Style="{StaticResource Muted}" Margin="{StaticResource Inset.0_8_0_0}" FontStyle="Italic" />
                        </DataTemplate>

                        <DataTemplate DataType="{x:Type vm:ErrorItem}">
                            <Border BorderBrush="{DynamicResource DangerBrush}" BorderThickness="{StaticResource Inset.2_0_0_0}" Padding="{StaticResource Inset.8_0}" Margin="{StaticResource Inset.0_8}">
                                <TextBox Style="{StaticResource MessageText}" Text="{Binding Text, Mode=OneWay}" Foreground="{DynamicResource DangerBrush}" />
                            </Border>
                        </DataTemplate>

                        <!-- The only boxed element in the chat: it needs a decision. -->
                        <DataTemplate DataType="{x:Type vm:ApprovalItem}">
                            <Border BorderThickness="{StaticResource Inset.1p5}" CornerRadius="{StaticResource Round.10}" Padding="{StaticResource Inset.16_16}" Margin="{StaticResource Inset.0_16}" Background="{DynamicResource RaisedBrush}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPending}" Value="False">
                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="Needs your OK" FontWeight="SemiBold" Style="{StaticResource Body}" />
                                    <TextBlock Text="{Binding Reason}" Style="{StaticResource Muted}" Margin="{StaticResource Inset.0_0_0_8}" />
                                    <TextBox Style="{StaticResource CodeText}" Foreground="{DynamicResource TextBrush}" FontSize="{StaticResource Metric.13}" Text="{Binding Summary, Mode=OneWay}" />
