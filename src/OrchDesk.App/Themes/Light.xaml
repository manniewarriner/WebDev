<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Cream light: paper-cream base, dark-brown ink, deeper terracotta so it passes contrast on cream. -->
    <Color x:Key="BaseColor">#FBF5EC</Color>
    <Color x:Key="SurfaceColor">#F3E8DA</Color>
    <Color x:Key="RaisedColor">#FFFCF7</Color>
    <Color x:Key="BorderColor">#E0CFBC</Color>
    <Color x:Key="TextColor">#2B1D15</Color>
    <Color x:Key="MutedColor">#76604F</Color>
    <Color x:Key="AccentColor">#A94D27</Color>
    <Color x:Key="AccentTextColor">#FFF8F2</Color>
    <Color x:Key="PeachColor">#D9895F</Color>
    <Color x:Key="DangerColor">#B23A28</Color>
    <Color x:Key="SuccessColor">#4F7A3F</Color>
    <Color x:Key="WarnColor">#9A6A12</Color>
    <Color x:Key="UserBubbleColor">#F0E0CC</Color>

    <SolidColorBrush x:Key="BaseBrush" Color="{StaticResource BaseColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="RaisedBrush" Color="{StaticResource RaisedColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}" />
    <SolidColorBrush x:Key="PeachBrush" Color="{StaticResource PeachColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" />
    <SolidColorBrush x:Key="UserBubbleBrush" Color="{StaticResource UserBubbleColor}" />
</ResourceDictionary>
