<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Warm dark: espresso browns instead of near-black, peach text, terracotta for action. -->
    <Color x:Key="BaseColor">#1E1612</Color>
    <Color x:Key="SurfaceColor">#271D17</Color>
    <Color x:Key="RaisedColor">#33271F</Color>
    <Color x:Key="BorderColor">#47372C</Color>
    <Color x:Key="TextColor">#F3E6DA</Color>
    <Color x:Key="MutedColor">#B39A86</Color>
    <Color x:Key="AccentColor">#C8643B</Color>
    <Color x:Key="AccentTextColor">#FFF4EC</Color>
    <Color x:Key="PeachColor">#F0B48E</Color>
    <Color x:Key="DangerColor">#E36B55</Color>
    <Color x:Key="SuccessColor">#9BC08A</Color>
    <Color x:Key="WarnColor">#E7B85C</Color>
    <Color x:Key="UserBubbleColor">#3B2C22</Color>

    <SolidColorBrush x:Key="BaseBrush" Color="{StaticResource BaseColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="RaisedBrush" Color="{StaticResource RaisedColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}" />
    <SolidColorBrush x:Key="PeachBrush" Color="{StaticResource PeachColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" />
    <SolidColorBrush x:Key="UserBubbleBrush" Color="{StaticResource UserBubbleColor}" />
</ResourceDictionary>
